ringbahn.v2.AttachedDevicesResponse.devices max_count:32
ringbahn.v2.InternalOtaWriteRequest.data max_size:4096
ringbahn.v2.InternalOtaStatus.sha256_hash max_size:32 fixed_length:true
ringbahn.v2.TerrabootSendBlockRequest.data max_size:256
ringbahn.v2.TerrabootRequestBlockResponse.data max_size:256
ringbahn.v2.TerrabootConnectResponse.mcu_type max_size:32
ringbahn.v2.TerrabootConnectResponse.terraboot_version max_size:64
ringbahn.v2.TerrabootConnectResponse.app_variant max_size:32
ringbahn.v2.TerrabootConnectResponse.app_version max_size:16
ringbahn.v2.TerrabootGetIdResponse.can_uuid max_size:12
ringbahn.v2.ThroughputTestRequest.payload max_size:240
ringbahn.v2.ThroughputTestResponse.payload max_size:240

# WiFi management. SSID is 32 bytes per 802.11, PSK is 8-63 ASCII for WPA2
# (+1 for nul, rounded to 64). IP string is 16 bytes (max IPv4 dotted-quad
# + nul). Network list capped at 16 entries to keep the encoded
# WifiNetworksResponse under the Ringbahn 246-byte payload ceiling.
ringbahn.v2.WifiNetwork.ssid max_size:33
ringbahn.v2.WifiNetworksResponse.networks max_count:8
ringbahn.v2.WifiConnectNetworkRequest.ssid max_size:33
ringbahn.v2.WifiConnectNetworkRequest.psk max_size:64
ringbahn.v2.WifiStatus.ssid max_size:33
ringbahn.v2.WifiStatus.ip max_size:16

# Bridge device name. 31 UTF-8 bytes + nul matches the firmware's
# device_name_buf[32] and NimBLE's default GAP device-name limit (31).
ringbahn.v2.SetBridgeNameRequest.name max_size:32
ringbahn.v2.BridgeNameResponse.name max_size:32

# Bluetooth devices. Name capped at 24 UTF-8 bytes + nul ("Xbox Wireless
# Controller" is 24). Known list is 3; scan pages are 4 so a page stays
# under the 245-byte Ringbahn payload ceiling.
ringbahn.v2.BluetoothAddress.value max_size:6 fixed_length:true
ringbahn.v2.KnownBluetoothDevice.name max_size:25
ringbahn.v2.DiscoveredBluetoothDevice.name max_size:25
ringbahn.v2.BluetoothStatus.known max_count:3
ringbahn.v2.BluetoothScanResults.results max_count:4
