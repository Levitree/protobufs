# Modbus Bridge Options - packed binary format sizes

# Read response packed data
# Coils/discrete: [qty:1][bits:4] = 5 bytes max
ringbahn.v1.ModbusReadCoilsResponse.packed_data max_size:5
ringbahn.v1.ModbusReadDiscreteInputsResponse.packed_data max_size:5
# Registers: [qty:1][values:64] = 65 bytes max (32 x 2-byte values)
ringbahn.v1.ModbusReadHoldingRegistersResponse.packed_data max_size:65
ringbahn.v1.ModbusReadInputRegistersResponse.packed_data max_size:65

# Write request packed data
# Multiple coils: [slave:1][addr:2][qty:1][bits:4] = 8 bytes max
ringbahn.v1.ModbusWriteMultipleCoilsRequest.packed_data max_size:8
# Multiple registers: [slave:1][addr:2][qty:1][values:64] = 68 bytes max
ringbahn.v1.ModbusWriteMultipleRegistersRequest.packed_data max_size:68
